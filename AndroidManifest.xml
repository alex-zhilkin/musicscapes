<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="local.musicscapes.tv" android:versionCode="30" android:versionName="5.14">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <uses-permission android:name="android.permission.INTERNET" />
  <uses-feature android:name="android.software.leanback" android:required="true" />
  <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
  <application android:label="MusicScapes" android:theme="@android:style/Theme.Material.NoActionBar" android:icon="@drawable/icon" android:banner="@drawable/banner" android:allowBackup="false" android:usesCleartextTraffic="false" android:extractNativeLibs="true">
    <receiver android:name=".ReviewExportReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    <receiver android:name=".DevLogsReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    <receiver android:name=".ArtistSourcesReceiver" android:exported="true" android:permission="android.permission.DUMP" />
    <activity android:name=".MainActivity" android:exported="true" android:screenOrientation="landscape">
      <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
